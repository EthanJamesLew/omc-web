build/
build-native/
emsdk/
*.o
*.a
*.bc
*.js.map
# Note: upstream/ used to be ignored when it held loose clones.
# It is now populated by git submodules (see .gitmodules + versions.lock).

# New-tree build outputs — never committed; `make all` regenerates.
projects/*/out/
runtime-fs/out/
msl/out/
web/public/
tests/runners/browser/node_modules/
tests/runners/node/node_modules/

# Old PoC assets (moved into re-poc/web/) — keep tracked so the frozen
# reference at v0.1-poc remains runnable.
!re-poc/web/omc.wasm
!re-poc/web/emscripten-libs/
!re-poc/web/emscripten-libs/*.a
!re-poc/web/model-bundle/
!re-poc/web/model-bundle/libs/*.a
!re-poc/web/model-bundle/objs/*.o

# The repo-root .gitignore ignores `*.mo` (for gettext translations).
# Our `.mo` files are Modelica source — track them.
!**/*.mo
