build/
build-native/
emsdk/
*.o
*.a
*.bc
*.js.map
# Note: upstream/ used to be ignored when it held loose clones.
# It is now populated by git submodules (see .gitmodules + versions.lock).

# New-tree build outputs — never committed; `make all` regenerates.
projects/*/out/
runtime-fs/out/
msl/out/
web/public/
tests/runners/browser/node_modules/
tests/runners/node/node_modules/

# Don't ignore the built wasm: it lives in web/ so the static site is
# self-contained when checked out. The build script regenerates it.
!web/omc.wasm

# Same rule for the in-browser compile assets — they're part of the
# distributed static site, not transient build output.
!web/emscripten-libs/
!web/emscripten-libs/*.a
!web/model-bundle/
!web/model-bundle/libs/*.a
!web/model-bundle/objs/*.o

# The repo-root .gitignore ignores `*.mo` (for gettext translations).
# Our `.mo` files are Modelica source — track them.
!**/*.mo
